{
  "name": "explanations",
  "version": "0.1.0",
  "description": "LLM-generated visual explanations as styleable HTML",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./themes/tokens.css": "./dist/themes/tokens.css",
    "./themes/light.css": "./dist/themes/light.css",
    "./themes/dark.css": "./dist/themes/dark.css"
  },  "files": ["dist"],
  "sideEffects": ["*.css", "src/core/registerAll.ts", "src/primitives/*"],
  "scripts": {
    "build": "tsup && mkdir -p dist/themes && cp src/themes/*.css dist/themes/",
    "test": "vitest run",
    "demo": "npm run build && node demo/server.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
