# Dependencies
node_modules/
jspm_packages/

# Build output
dist/
build/
out/
*.tsbuildinfo

# Logs & debug output
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Test coverage
coverage/
*.lcov
.nyc_output/

# Environment variables
.env
.env.*
!.env.example

# Caches
.cache/
.eslintcache
.stylelintcache
.parcel-cache/

# Package manager state
.npm/
*.tgz
.yarn/install-state.gz
.yarn/build-state.yml
.pnp.*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Editor directories & files (VS Code: shared config stays tracked, local junk ignored)
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.idea/
*.swp

# OS files
.DS_Store
Thumbs.db

# Local agent/tooling state — machine-specific, regenerable, not project source.
# (.vexp/ manifest is a derived cache: per-file hashes churn on every edit and
# the index rebuilds from source, so we don't track it despite vexp's default.)
.codex/
.superpowers/
.superpowers_bookkeeping
.vexp/
